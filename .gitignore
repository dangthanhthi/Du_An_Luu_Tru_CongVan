# Root gitignore to prevent pushing build artifacts and packages

# Node / Next.js
**/node_modules/
**/.next/
**/out/
**/build/
.env*.local

# .NET / C#
**/bin/
**/obj/
**/publish/
*.user
*.suo

# Large Templates & Temp
Theme Template/
scratch/
.agents/

# OS / Binary files
.DS_Store
Thumbs.db
*.exe
*.lnk
*.log
