      "name": "3. AuthService",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Login succeeded\", function () {",
                  "    pm.expect(response.success).to.eql(true);",
                  "    pm.expect(response.data.accessToken).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.environment.set(\"token\", response.data.accessToken);",
                  "pm.environment.set(\"refreshToken\", response.data.refreshToken);",
                  "",
                  "if (response.data.user?.id) {",
                  "    pm.environment.set(\"userId\", response.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_user\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
