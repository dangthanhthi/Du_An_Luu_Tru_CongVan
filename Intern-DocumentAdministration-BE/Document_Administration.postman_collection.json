                  "    pm.expect(response.data.id).to.exist;",
                  "    pm.expect(response.data.status).to.eql(\"Draft\");",
                  "});",
                  "pm.environment.set(\"documentId\", response.data.id);",
                  "if (response.data.attachments?.length) {",
