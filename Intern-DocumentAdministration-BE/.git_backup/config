[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Seleton-VN/Intern-DocumentAdministration-BE.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "feature/document-service"]
	remote = origin
	merge = refs/heads/feature/document-service
	vscode-merge-base = origin/main
[branch "feature/partner-service"]
	remote = origin
	merge = refs/heads/feature/partner-service
[branch "feature/ai-ocr-service"]
	remote = origin
	merge = refs/heads/feature/ai-ocr-service
