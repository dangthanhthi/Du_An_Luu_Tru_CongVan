## ===== Secrets — never commit =====
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.*.local.json

## ===== .NET build output (applies to every service folder) =====
bin/
obj/
out/
*.user
*.suo

## ===== EF Core =====
# Migrations themselves ARE committed (they're code, not output) —
# do not ignore services/*/Migrations/

## ===== Visual Studio / VS Code / Rider =====
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.DotSettings.user

## ===== Docker =====
# Local bind-mounted data (if any service writes to a mounted volume)
**/storage-uploads/
docker-data/

## ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini

## ===== SQLite & Local Uploads =====
*.db
*.db-shm
*.db-wal
*.db-journal
!services/files-service/Uploads/**
**/storage/
.agents/
scratch/
test_documents/
*.ps1
*.bat
!START_LOCAL.bat
!START_LOCAL_SYSTEM.bat
!CHAY_TOAN_BO_BACKEND.bat
!RUN_ALL_SERVICES.bat
!INSTALL_PREREQUISITES.bat
*.html

## ===== Logs =====
*.log
logs/

## ===== NuGet =====
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
